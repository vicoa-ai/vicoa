.gstack
.vscode
__pycache__/
.DS_Store

# PII exports (raw user emails) — never commit
cookies.json
secrets/

# ── Secrets & credentials hardening (open-source prep) ──────────────
# Env files anywhere; keep committed *.example templates
.env
.env.*
!*.example
# Signing keys, certs, service-account & credential files
*.pem
*.p12
*.p8
*.jks
*.keystore
*service-account*.json
credentials.json

# Claude Code's local state stays out, except the shared project skills: each
# entry in .claude/skills is a symlink into .agents/skills, which Codex reads.
**/.claude/*
!/.claude/skills/
.temp/

# Local Netlify folder
.netlify
# Netlify edge-function Deno lockfile (generated by `netlify build`)
apps/web/deno.lock
