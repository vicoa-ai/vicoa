# development or production
ENVIRONMENT=development

# Database
PRODUCTION_DB_URL=postgresql://postgres:XXXXXX.supabase.co:5432/postgres # For Render use Session Pooler
DEVELOPMENT_DB_URL=postgresql://user:password@localhost:5432/agent_dashboard

# MCP Server
MCP_SERVER_PORT=8080

# Backend API
API_PORT=8000
# Frontend URLs - JSON array of allowed frontend origins
# Single URL: FRONTEND_URLS="https://example.com"
# Multiple URLs: FRONTEND_URLS='["http://localhost:3000", "https://example.com"]'
# Production example with all domains:
# FRONTEND_URLS='["https://vicoa.ai", "https://www.vicoa.ai", "https://vibecodeanywhere.com", "https://www.vibecodeanywhere.com", "https://app.vicoa.ai"]'
FRONTEND_URLS='["http://localhost:3000"]'

VICOA_WS_URL=ws://localhost:8080/ws

# Supabase Configuration
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Signing Keys for API Keys (generate with scripts/generate-jwt-keys.sh)
JWT_PRIVATE_KEY=your-jwt-private-key-here
JWT_PUBLIC_KEY=your-jwt-public-key-here

SENTRY_DSN=123.us.sentry.io/456

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Billing Configuration (optional - for SaaS deployments)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...  # Backward-compatible monthly fallback
# STRIPE_PRO_MONTHLY_PRICE_ID=price_...  # Pro monthly recurring price
# STRIPE_PRO_ANNUAL_PRICE_ID=price_...  # Pro annual recurring price
# STRIPE_PRO_TRIAL_DAYS=7

# Twilio Configuration (optional - for SMS and Email notifications)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_PHONE_NUMBER=+1234567890  # Your Twilio phone number in E.164 format
# TWILIO_SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_EMAIL=notifications@example.com  # Verified sender email address

# ConvertKit Configuration (optional - for email marketing)
CONVERTKIT_API_KEY=your_convertkit_api_key_here

# Listmonk Configuration (optional - self-hosted marketing list, taking over from ConvertKit)
# Leave unset to disable: new users are then simply not subscribed.
# LISTMONK_URL=https://mail.example.com
# LISTMONK_API_USER=api-user              # a Listmonk user of type "api"
# LISTMONK_API_TOKEN=your_listmonk_api_token_here
# LISTMONK_LIST_NAME=users                # name of the list new users are added to (default: users)

# Support inbox that receives "report an issue" emails. Leave unset to disable
# the /support/report-issue endpoint (it then returns 503).
# SUPPORT_EMAIL=support@example.com

# RevenueCat Configuration (optional - for mobile subscription management)
# REVENUECAT_SECRET_KEY=your_revenuecat_secret_key_here
# REVENUECAT_WEBHOOK_AUTH_HEADER=your_webhook_auth_header_here

# Superwall Configuration (optional - for mobile subscription management)
# SUPERWALL_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SUPERWALL_API_TOKEN=...  # Organization API key from Settings > Access Controls > API Keys; used for backend reconciliation calls to the V2 REST API
# (Application IDs are code constants in backend.api.mobile_billing — see
# SUPERWALL_APPLICATION_IDS — since they're tied to the Superwall account,
# not the deployment environment.)

# Mailgun Configuration (optional - for cancellation/refund lifecycle emails)
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_FROM_EMAIL=Vicoa Billing <billing@yourdomain.com>

# Resend Configuration (email sending; migrating off Mailgun)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Vicoa <hi@yourdomain.com>

# Firebase Cloud Messaging (FCM) Configuration (optional - for Flutter push notifications)
# Option 1: Use service account file path
# FCM_SERVICE_ACCOUNT_KEY_PATH=/path/to/your/firebase-service-account.json
# Option 2: Use service account JSON as environment variable (recommended for deployment)
FCM_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id",...}'

# S3 credentials for message image attachments (bucket name is a code
# constant: shared.storage.ATTACHMENTS_BUCKET). Leave empty to use boto3's
# default chain (IAM role, ~/.aws).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
