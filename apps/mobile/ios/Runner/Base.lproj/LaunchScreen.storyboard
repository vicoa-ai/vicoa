                                    <constraint firstAttribute="height" constant="59.473684210526315" id="Lh7-Rm-q1B"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" red="0.086274509803921567" green="0.10980392156862745" blue="0.14117647058823529" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="YRO-k0-Ey4" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="1a2-6s-vTC"/>
                            <!-- centerY = 5/11 * (H - h) + h/2 = (10/11) * (H/2) + h/22 -->
                            <constraint firstItem="YRO-k0-Ey4" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" multiplier="0.90909090909090906" constant="2.7033492822966507" id="4X2-HB-R7a"/>
                        </constraints>
