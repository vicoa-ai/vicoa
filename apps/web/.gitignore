# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# fumadocs-mdx generated cache (regenerated on every dev/build)
/.source/

# production
/build

# misc
.DS_Store
*.pem

