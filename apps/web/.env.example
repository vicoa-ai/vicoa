# Example .env format. Copy to .env.local and fill in real values.
BASE_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://***.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=***

# Agent Dashboard API Integration (optional)
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000
# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=***.apps.googleusercontent.com
# Apple OAuth
NEXT_PUBLIC_APPLE_CLIENT_ID=app.vicoa.***
# PostHog
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_***
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# WebSocket endpoint on the agent-facing server app (vicoa-server / agents.vicoa.ai:443).
# MUST be prefixed `NEXT_PUBLIC_` so Next.js exposes it to the browser bundle —
# `lib/ws-client.ts` reads it via `process.env.NEXT_PUBLIC_VICOA_WS_URL`.
NEXT_PUBLIC_VICOA_WS_URL=ws://localhost:8080/ws