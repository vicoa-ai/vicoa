# Vicoa self-hosting — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Used by docker-compose.selfhost.yml. Full walkthrough: SELF_HOSTING.md.
#
# Only the REQUIRED block matters to get running. Everything under OPTIONAL
# self-disables when its key is empty — no stubs, no placeholder accounts.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Database. The compose file builds PRODUCTION_DB_URL from these three; set
# PRODUCTION_DB_URL directly instead if you bring your own Postgres.
POSTGRES_USER=vicoa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vicoa
# PRODUCTION_DB_URL=postgresql://user:password@host:5432/vicoa

# Where each piece is reachable FROM A BROWSER / your phone. On a server, these
# must be the public URLs (behind TLS), not localhost — the mobile app and any
# remote machine resolve them literally.
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:8000
PUBLIC_WS_URL=ws://localhost:8080/ws
# Host ports the compose stack publishes (change on port clashes).
WEB_PORT=3000
BACKEND_PORT=8000
SERVER_PORT=8080

# Authentication. `builtin` keeps identity inside your own Postgres — email +
# password, no external service, nothing else to configure. `supabase` delegates
# to a Supabase project instead (what Vicoa's hosted service runs), which buys
# social login, MFA and password recovery you do not have to operate.
# Both values must match between the backend and the web build.
AUTH_PROVIDER=builtin
NEXT_PUBLIC_AUTH_PROVIDER=builtin

# Close signup once your accounts exist — otherwise anyone who can reach the
# server can create one.
# BUILTIN_ALLOW_SIGNUP=true
# Requires a mail provider below; leave off if you have none, or you will lock
# yourself out.
# BUILTIN_REQUIRE_EMAIL_VERIFICATION=false
# Session lifetime in hours (default 720 = 30 days).
# BUILTIN_SESSION_TTL_HOURS=720

# --- AUTH_PROVIDER=supabase only ---
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The project's legacy JWT secret (Settings → API). With it, access tokens are
# verified locally instead of by a network call to Supabase on every request.
# Leave it unset if the project has asymmetric signing keys enabled — those are
# verified against its published JWKS with no secret at all.
# SUPABASE_JWT_SECRET=

# Agent API-key signing (RS256). Generate with:
#   ./backend/scripts/generate-jwt-keys.sh selfhost/keys
# The compose file mounts them and sets JWT_PRIVATE_KEY_FILE / JWT_PUBLIC_KEY_FILE,
# so nothing to paste here. Outside Docker, either point at the files or inline
# the PEMs into JWT_PRIVATE_KEY / JWT_PUBLIC_KEY.
# JWT_PRIVATE_KEY_FILE=/keys/jwt_private.pem
# JWT_PUBLIC_KEY_FILE=/keys/jwt_public.pem

# Shared secret for the backend → server realtime bridge. Both processes read
# it; a mismatch means the WebSocket stops receiving updates (the endpoint
# 401s), so set it to any long random string:  openssl rand -hex 32
INTERNAL_BROADCAST_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — every one of these is off when unset
# ─────────────────────────────────────────────────────────────────────────────

# Session titles. Vicoa asks an LLM to name sessions; without a key, titles fall
# back to a truncated first message. ANTHROPIC_API_KEY is the primary path,
# OPENROUTER_API_KEY the fallback chain.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Voice input transcription in the clients.
# DEEPGRAM_API_KEY=

# Attachments (message images). Empty falls back to boto3's default credential
# chain (IAM role, ~/.aws/credentials); leave blank to disable uploads.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Transactional email — "report an issue", account mails. Pick one provider.
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Vicoa <hi@yourdomain.com>
# MAILGUN_API_KEY=key-...
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_FROM_EMAIL=Vicoa <billing@yourdomain.com>
# MAILGUN_BCC_EMAIL=
# Inbox that receives "report an issue" reports. Unset → that endpoint 503s.
# SUPPORT_EMAIL=support@yourdomain.com

# Push notifications to the mobile app (Firebase Cloud Messaging). Only useful
# if you also ship your own build of the mobile app.
# FCM_SERVICE_ACCOUNT_KEY_PATH=/keys/firebase-service-account.json
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# SMS / email notifications when an agent needs an answer.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE_NUMBER=+15551234567
# TWILIO_SENDGRID_API_KEY=
# TWILIO_FROM_EMAIL=notifications@yourdomain.com

# Error tracking.
# SENTRY_DSN=

# Web-side keys (OAuth buttons, product analytics) live in apps/web's own env —
# see apps/web/.env.example. The backend collects no analytics of its own.

# Mailing list for new signups (self-hosted Listmonk). Unset → nobody is
# subscribed to anything.
# LISTMONK_URL=https://mail.yourdomain.com
# LISTMONK_API_USER=api-user
# LISTMONK_API_TOKEN=
# LISTMONK_LIST_NAME=users
